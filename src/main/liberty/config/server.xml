<server description="Jakarta EE Laboratory">

    <featureManager>
        <feature>servlet-6.1</feature>
        <feature>persistence-3.2</feature>
        <feature>jsonb-3.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint" httpPort="9080" httpsPort="9443"/>

    <library id="h2Lib">
        <fileset dir="${shared.resource.dir}/h2" includes="*.jar"/>
    </library>

    <dataSource jndiName="jdbc/quest">
        <jdbcDriver libraryRef="h2Lib"/>
        <properties url="jdbc:h2:file:/tmp/jakarta-ee-laboratory;AUTO_SERVER=TRUE" user="admin" password="password"/>
    </dataSource>

    <webApplication location="jakarta-ee-laboratory.war" contextRoot="/"/>

</server>
