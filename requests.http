@baseUrl = http://localhost:9080/api/jaxrs
@artistId = 11111111-1111-1111-1111-111111111111
@artistId2 = 22222222-2222-2222-2222-222222222222
@vinylId = 33333333-3333-3333-3333-333333333333

### Wszystkie kategorie -> 200 OK
GET {{baseUrl}}/artists
Accept: application/json

### Jedna kategoria -> 200 OK
GET {{baseUrl}}/artists/{{artistId}}
Accept: application/json

### Jedna kategoria, która nie istnieje -> 404 Not Found
GET {{baseUrl}}/artists/00000000-0000-0000-0000-000000000000
Accept: application/json

### Dodaj nową kategorię -> 201 Created
POST {{baseUrl}}/artists
Content-Type: application/json
Accept: application/json

{
  "name": "Pearl Jam",
  "formationYear": 1990,
  "isActive": true
}

### Modyfikuj istniejącą kategorię -> 200 OK
PUT {{baseUrl}}/artists/{{artistId}}
Content-Type: application/json
Accept: application/json

{
  "name": "Nirvana (Updated)",
  "formationYear": 1987,
  "isActive": false
}

### Usuń kategorię -> 204 No Content
DELETE {{baseUrl}}/artists/{{artistId2}}

###
### Pobierz wszystkie płyty wybranego artysty -> 200 OK
GET {{baseUrl}}/artists/{{artistId}}/vinyls
Accept: application/json

### Pobierz konkretną płytę artysty -> 200 OK
GET {{baseUrl}}/artists/{{artistId}}/vinyls/{{vinylId}}
Accept: application/json

### Płyta, która nie istnieje -> 404 Not Found
GET {{baseUrl}}/artists/{{artistId}}/vinyls/00000000-0000-0000-0000-000000000000
Accept: application/json

### Dodaj nową płytę do artysty -> 201 Created
POST {{baseUrl}}/artists/{{artistId}}/vinyls
Content-Type: application/json
Accept: application/json

{
  "title": "MTV Unplugged in New York",
  "releaseDate": "1994-11-01",
  "price": -159.99,
  "condition": "VERY_GOOD"
}

### 2.4 Modyfikuj płytę artysty -> 200 OK
PUT {{baseUrl}}/artists/{{artistId}}/vinyls/{{vinylId}}
Content-Type: application/json
Accept: application/json

{
  "title": "Nevermind (Remastered)",
  "releaseDate": "1994-11-01",
  "price": 179.99,
  "condition": "POOR"
}

### 2.5 Usuń płytę artysty -> 204 No Content
DELETE {{baseUrl}}/artists/{{artistId}}/vinyls/{{vinylId}}